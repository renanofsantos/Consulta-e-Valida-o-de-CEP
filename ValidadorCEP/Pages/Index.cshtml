@page
@model ValidadorCEP.Pages.IndexModel
@{
}

<style>
    
    :root {
        --bg: #0a0e14;
        --panel: #131a24;
        --panel-border: #232d3d;
        --blue: #2f81f7;
        --blue-dim: #1c4a8c;
        --white: #eef2f7;
        --gray: #7d8ba1;
        --font-mono: 'JetBrains Mono', 'Space Mono', monospace;
        --font-body: 'Inter', system-ui, sans-serif;
    }

  
    body {
        background: var(--bg);
        background-image: linear-gradient(rgba(47, 129, 247, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(47, 129, 247, 0.05) 1px, transparent 1px);
        background-size: 40px 40px;
        color: var(--white);
        font-family: var(--font-body);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 24px;
    }

    
    .console {
        width: 100%;
        max-width: 480px;
        border: 1px solid var(--panel-border);
        background: var(--panel);
        position: relative;
        padding: 32px;
    }

        .console::before,
        .console::after,
        .console-inner::before,
        .console-inner::after {
            content: "";
            position: absolute;
            width: 14px;
            height: 14px;
            border: 2px solid var(--blue);
        }

        .console::before {
            top: -1px;
            left: -1px;
            border-right: none;
            border-bottom: none;
        }

        .console::after {
            top: -1px;
            right: -1px;
            border-left: none;
            border-bottom: none;
        }

    .console-inner::before {
        bottom: -1px;
        left: -1px;
        border-right: none;
        border-top: none;
    }

    .console-inner::after {
        bottom: -1px;
        right: -1px;
        border-left: none;
        border-top: none;
    }

  
    .eyebrow {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.2em;
        color: var(--blue);
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    h1 {
        font-family: var(--font-mono);
        font-size: 22px;
        font-weight: 600;
        margin: 0 0 24px 0;
        color: var(--white);
    }

    label {
        display: block;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--gray);
        margin-bottom: 8px;
        letter-spacing: 0.05em;
    }

    .input-row {
        display: flex;
        gap: 8px;
        position: relative;
    }

    input[type="text"] {
        flex: 1;
        background: #0d131c;
        border: 1px solid var(--panel-border);
        color: var(--white);
        font-family: var(--font-mono);
        font-size: 15px;
        padding: 12px 14px;
        letter-spacing: 0.05em;
        outline: none;
        transition: border-color 0.2s ease;
    }

        input[type="text"]:focus {
            border-color: var(--blue);
        }

    button {
        background: var(--blue);
        color: #061223;
        border: none;
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0 20px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        button:hover {
            background: #4a94ff;
        }

    /* linha animada efeito scan que aparece só quando tem resultado */
    .scan-line {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--blue), transparent);
        margin: 28px 0;
        animation: scan 2.4s ease-in-out infinite;
    }

    
    @@keyframes scan {
        0%, 100% {
            opacity: 0.25;
        }

        50% {
            opacity: 1;
        }
    }

    .erro {
        font-family: var(--font-mono);
        font-size: 13px;
        color: #ff5c5c;
        border-left: 2px solid #ff5c5c;
        padding-left: 12px;
        margin-top: 20px;
    }

    .resultado {
        margin-top: 8px;
    }

    .resultado-titulo {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.2em;
        color: var(--blue);
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    /* Cada linha de dado (RUA, BAIRRO, etc): rótulo à esquerda,
       valor à direita, com separador embaixo. */
    .linha-dado {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid var(--panel-border);
        font-size: 14px;
    }

        .linha-dado:last-child {
            border-bottom: none;
        }

        .linha-dado .rotulo {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--gray);
            letter-spacing: 0.08em;
            white-space: nowrap;
            padding-top: 2px;
        }

        .linha-dado .valor {
            color: var(--white);
            text-align: right;
        }

    .app-footer {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        color: var(--gray);
        text-align: center;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--panel-border);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .app-footer-dev strong {
        color: var(--blue);
        font-weight: 600;
    }
</style>

<div class="console">
    <div class="console-inner">
        <div class="eyebrow">// sistema de consulta</div>
        <h1>Validador de CEP</h1>

 
        <form method="post">
            <label for="Cep">CEP</label>
            <div class="input-row">
               
                <input type="text" id="Cep" name="Cep" value="@Model.Cep" placeholder="00000-000" autocomplete="off" />
                <button type="submit">Buscar</button>
            </div>
        </form>

       
        @if (Model.MensagemErro != null)
        {
            <p class="erro">[ERRO] @Model.MensagemErro</p>
        }

        
        @if (Model.Endereco != null)
        {
            <div class="scan-line"></div>
            <div class="resultado">
                <div class="resultado-titulo">registro encontrado</div>
                <div class="linha-dado">
                    <span class="rotulo">[RUA]</span>
                    <span class="valor">@Model.Endereco.Logradouro</span>
                </div>
                <div class="linha-dado">
                    <span class="rotulo">[BAIRRO]</span>
                    <span class="valor">@Model.Endereco.Bairro</span>
                </div>
                <div class="linha-dado">
                    <span class="rotulo">[CIDADE]</span>
                    <span class="valor">@Model.Endereco.Localidade</span>
                </div>
                <div class="linha-dado">
                    <span class="rotulo">[ESTADO]</span>
                    <span class="valor">@Model.Endereco.Uf</span>
                </div>
            </div>
        }

       
        <footer class="app-footer">
            <span class="app-footer-line">© @DateTime.Now.Year Validador de CEP</span>
            <span class="app-footer-dev">desenvolvido por <strong>Renan Santos</strong></span>
        </footer>
    </div>
</div>
